cat > .env.example << 'EOF'
# Copy this file to .env and fill in real values for local development.
# .env itself is gitignored and never committed - this file (.env.example)
# is the one that stays in the repo, so anyone cloning it knows exactly
# what environment variables the project reads, without guessing.

BASE_URL=https://your-portfolio-url.com
BROWSER=chrome
HEADLESS=false

# --- Optional: only needed if running against a Selenium Grid locally ---
# SELENIUM_REMOTE_URL=http://localhost:4444/wd/hub

# --- Optional: only relevant if running the Execution API script locally ---
# TEST_MARKER=
EOF